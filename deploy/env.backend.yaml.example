# Copy to deploy/env.backend.yaml (gitignored) before running deploy-backend.sh.
# Both meeting-api and meeting-worker use the same env file.

DJANGO_SECRET_KEY: "replace-with-openssl-rand-hex-32"
DJANGO_DEBUG: "False"

# After first deploy: set to your exact Cloud Run API hostname (no https://)
# e.g. "meeting-api-xxxxx-uc.a.run.app"
ALLOWED_HOSTS: "*"

TRANSCRIPTION_BACKEND: "whisper_local"
WHISPER_MODEL: "base"

# PostgreSQL — required for production.
# Cloud SQL Unix socket (recommended with --add-cloudsql-instances):
#   DATABASE_URL: "postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE"
# Public IP fallback (less secure):
DATABASE_URL: "postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Redis (Upstash or similar) — required when DATABASE_URL is set.
# App injects ssl_cert_reqs=CERT_REQUIRED automatically for rediss:// URLs.
CELERY_BROKER_URL: "rediss://default:YOUR_UPSTASH_TOKEN@YOUR-REDIS.upstash.io:6379"
CELERY_RESULT_BACKEND: "rediss://default:YOUR_UPSTASH_TOKEN@YOUR-REDIS.upstash.io:6379"

# GCS bucket for shared media (required for split API + worker).
# Both services must have roles/storage.objectAdmin on this bucket.
GS_MEDIA_BUCKET: "YOUR_PROJECT_ID-meeting-media"
GCP_PROJECT_ID: "YOUR_PROJECT_ID"

# CORS: add your frontend Cloud Run URL after first frontend deploy.
# Comma-separated, no spaces, no trailing slashes.
CORS_ALLOWED_ORIGINS: "https://meeting-frontend-xxxxx-uc.a.run.app,http://localhost:5173"
CSRF_TRUSTED_ORIGINS: "https://meeting-api-xxxxx-uc.a.run.app"

# Anthropic API key — from https://console.anthropic.com/
ANTHROPIC_API_KEY: "your-anthropic-api-key"
