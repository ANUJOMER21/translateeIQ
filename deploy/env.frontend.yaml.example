# Frontend has no runtime env file — VITE_API_URL is baked into the JS bundle at build time.
# Pass it as an environment variable before running deploy-frontend.sh:
#
#   export VITE_API_URL="https://meeting-api-xxxxx-uc.a.run.app/api"
#   ./deploy/deploy-frontend.sh
#
# The deploy script passes VITE_API_URL as a Docker build-arg via Cloud Build.
# You do NOT need to create an env.yaml for the frontend service.
