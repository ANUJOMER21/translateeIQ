# Copy to gcp-run.env.yaml (gitignored) and pass: GCP_ENV_FILE=deploy/gcp-run.env.yaml ./deploy/deploy-gcp-cloud-run.sh
# Use the real Cloud Run hostname for ALLOWED_HOSTS after first deploy (or keep * only for quick tests).
#
# Full-stack image (repo-root Dockerfile): SPA + API on one URL. Set SERVE_SPA=1 (default in image ENV; repeat here if you override all env vars).

DJANGO_SECRET_KEY: "replace-with-openssl-rand-hex-32"
DJANGO_DEBUG: "False"
ALLOWED_HOSTS: "*"
SERVE_SPA: "1"
TRANSCRIPTION_BACKEND: "whisper_local"
WHISPER_MODEL: "base"

# PostgreSQL (required for durable production)
# Public IP Cloud SQL — must allow inbound 5432 from Cloud Run egress (prefer Cloud SQL Connector below).
DATABASE_URL: "postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
#
# Recommended on GCP: Unix socket via Cloud Run → Cloud SQL attachment (deploy with CLOUDSQL_CONNECTION_NAME).
# DATABASE_URL: "postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME"

# Same Cloud Run URL as the API (full-stack deploy): browser is same-origin — CORS mainly matters for local dev or split hosting.
# Comma-separated list (one line). Example split hosting: "https://your-app.vercel.app,http://localhost:5173"
CORS_ALLOWED_ORIGINS: "https://YOUR-SERVICE-xxxxx.run.app,http://localhost:5173"
CSRF_TRUSTED_ORIGINS: "https://YOUR-SERVICE-xxxxx.run.app"

# Upstash: rediss:// — the app injects ssl_cert_reqs=CERT_REQUIRED if missing (Celery 5.x).
# Optionally set explicitly: ...upstash.io:6379?ssl_cert_reqs=CERT_REQUIRED
CELERY_BROKER_URL: "rediss://default:YOUR_UPSTASH_TOKEN@YOUR-REDIS.upstash.io:6379"
CELERY_RESULT_BACKEND: "rediss://default:YOUR_UPSTASH_TOKEN@YOUR-REDIS.upstash.io:6379"

# From https://console.anthropic.com/ — never commit the real value
ANTHROPIC_API_KEY: "<your_anthropic_api_key>"

# Shared media for split Cloud Run API + worker (chunk uploads + assembly + transcribe). See deploy/STEP-BY-STEP-GCP.md Step 8b.
# GS_MEDIA_BUCKET: "YOUR_PROJECT_ID-meeting-media"
# GCP_PROJECT_ID: "YOUR_PROJECT_ID"
