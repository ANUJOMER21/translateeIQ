# Copy to .env for local development

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — leave unset to use SQLite (simplest local). For Docker: `docker compose up -d`
# then set:
# DATABASE_URL=postgres://meeting:meeting@127.0.0.1:5432/meeting
# DATABASE_CONN_MAX_AGE=600

CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Optional: run tasks in-process (no separate `celery worker` terminal). Dev-only.
# CELERY_TASK_ALWAYS_EAGER=True

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

TRANSCRIPTION_BACKEND=mock
WHISPER_MODEL=base

CHROMA_DB_PATH=chroma_db
MEDIA_ROOT=media

# Optional: GCS bucket for media (split API + worker on GCP). Omit locally to use filesystem MEDIA_ROOT.
# GS_MEDIA_BUCKET=
# GCP_PROJECT_ID=

# Cap for "chat all meetings" when vector search returns nothing (see production readiness doc)
CHAT_ALL_MEETINGS_FALLBACK_LIMIT=5

# JWT lifetimes (optional)
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=14
