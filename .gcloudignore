# Used by `gcloud builds submit` (Cloud Build upload). Without this, the whole tree
# including node_modules and venvs is uploaded (slow / huge).

.git
.gitignore
.cursor
**/__pycache__
**/*.pyc
**/.pytest_cache

# Node / frontend
node_modules/
dist/

# Python envs (any path)
**/.venv/
**/.venv*/
**/venv/

backend/db.sqlite3
backend/media/
backend/chroma_db/
backend/staticfiles/

.env
**/.env
**/.env.*

*.md
!README.md
docs/

# Local / IDE
terminals/
.idea/
*.log
